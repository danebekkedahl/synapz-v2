{
  "name": "synapz-hockey-v2",
  "private": true,
  "version": "2.0.0",
  "description": "SYNAPZ Hockey V2.0 — Tablet-First Off-Ice Hockey IQ Training Game & Coaching Studio",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc --noEmit && vite build && node -e \"import('node:fs').then(fs=>fs.writeFileSync('dist/.nojekyll',''))\"",
    "preview": "vite preview --port 5173",
    "typecheck": "tsc --noEmit",
    "test:qa": "playwright test qa/v2_tablet_smoke.spec.ts",
    "test:matrix": "playwright test qa/v2_universal_devices.spec.ts",
    "test:live": "playwright test qa/v2_live_pages.spec.ts",
    "deploy:pages": "node scripts/deploy-v2-pages.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
